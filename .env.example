# ========================================
# CONFIGURACIÓN SIFEN - FACTURACIÓN ELECTRÓNICA
# ========================================

# ----------------------------------------
# Modo de Operación
# ----------------------------------------
# Usar Mock-SET (true) o SET Real (false)
# Para producción: dejar en false o comentar
SIFEN_USAR_MOCK=true

# URL del servidor Mock-SET (solo desarrollo)
SIFEN_MOCK_URL=http://127.0.0.1:8082

# ----------------------------------------
# Ambiente de SET (solo producción)
# ----------------------------------------
# Valores: 'test' | 'prod'
# Solo aplica cuando SIFEN_USAR_MOCK=false
SIFEN_AMBIENTE=test

# ----------------------------------------
# Timeout y Debug
# ----------------------------------------
# Timeout para requests HTTP (milisegundos)
SIFEN_TIMEOUT=30000

# Habilitar logs de debug
SIFEN_DEBUG=false

# ----------------------------------------
# Ambiente reportado en la consulta de estado (routes/invoices.js)
# Valores: 'test' | 'prod'
# ----------------------------------------
AMBIENTE_SET=test

# ----------------------------------------
# MongoDB
# ----------------------------------------
# En Docker/Dokploy usar el nombre del servicio, no 127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/sifen_db

# ----------------------------------------
# Redis (colas de Bull)
# ----------------------------------------
# Opcion A (recomendada): URL completa, tal como la entregan Dokploy,
# Railway, Upstash, etc. Incluye la contrasena.
#   REDIS_URL=redis://default:contrasena@host:6379
#   REDIS_URL=rediss://default:contrasena@host:6379   (TLS)
# REDIS_URL=

# Opcion B: variables sueltas (si no se usa REDIS_URL)
# En Docker/Dokploy, REDIS_HOST es el nombre del servicio, no 127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_USERNAME=
# REDIS_DB=0

# ----------------------------------------
# Servidor Backend
# ----------------------------------------
PORT=8081

# ----------------------------------------
# CORS (origenes del frontend)
# ----------------------------------------
# Lista separada por comas con los origenes que pueden llamar a la API.
# Necesario cuando el frontend NO se sirve detras del mismo dominio/proxy,
# es decir, cuando en el frontend se configura una URL de backend distinta.
# Con '*' se acepta cualquier origen (comodo en desarrollo, abierto en produccion).
CORS_ORIGINS=*

# ----------------------------------------
# JWT (Autenticación)
# ----------------------------------------
# OBLIGATORIO: el servidor no arranca sin un secreto propio (y rechaza este
# valor de ejemplo). Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=tu_secreto_super_secreto_cambiar_en_produccion
JWT_EXPIRES_IN=24h

# ----------------------------------------
# Certificados digitales (.p12)
# ----------------------------------------
# OBLIGATORIO: clave maestra con la que se cifran las contraseñas de los
# certificados en la base de datos (AES-256-GCM). Sin esto, toda factura falla
# al intentar descifrar la contraseña del certificado.
#
# ⚠️ Se usan los primeros 32 caracteres. Si la cambiás, las contraseñas ya
#    guardadas quedan indescifrables: hay que volver a cargar los certificados.
#    Guardala en un lugar seguro y NO la pierdas.
#
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
CERTIFICADO_MASTER_KEY=

# Carpeta donde se guardan los .p12 (por defecto ./certificados)
# En Docker conviene un volumen persistente.
# CERTIFICADOS_PATH=/app/certificados

# ----------------------------------------
# KUDE / PDF (Java + JasperReports)
# ----------------------------------------
# Ejecutable de Java usado para generar el PDF.
# Acepta la ruta al binario o un JAVA_HOME (directorio).
# Si no se define, se usa JAVA8_HOME, JAVA_HOME o el `java` del PATH.
# OJO: el CreateKude.jar propio (assets/kude) requiere Java 21 o superior.
# KUDE_JAVA_PATH=/usr/lib/jvm/java-21-openjdk-amd64/bin/java

# Timeout de la generacion del PDF, en milisegundos
# KUDE_TIMEOUT_MS=120000

# Rutas alternativas para los artefactos propios (normalmente no hace falta)
# KUDE_JAR_PATH=./assets/kude/CreateKude.jar
# KUDE_JASPER_DIR=./assets/kude/jasper
# KUDE_RUNTIME_DIR=./.kude/DE

# Verificar el entorno de KUDE (genera un PDF de prueba):
#   npm run kude:doctor

# ----------------------------------------
# Cotizaciones automáticas (worker:cotizacion)
# ----------------------------------------
# El proveedor y las monedas se eligen por empresa desde la UI (Cotizaciones →
# Actualización automática). Acá solo se ajusta la cadencia del worker.
#
# En Paraguay la cotización que rige para facturar el día D es la que la
# SET/DNIT publicó el día D-1. Al cambiar el día (hora de Asunción) el worker
# la busca; si la fuente todavía no publicó, reintenta.
#
# Ventana en la que se espera la actualización (hora de Asunción) y su
# frecuencia de reintento:
# COTIZACION_VENTANA_DESDE=0
# COTIZACION_VENTANA_HASTA=6
# COTIZACION_INTERVALO_ACTIVO_MS=300000    # 5 min dentro de la ventana
# COTIZACION_INTERVALO_REPOSO_MS=3600000   # 60 min el resto del día
#
# Cuando la cotización del día ya está cargada, el worker NO consulta la red.

# ----------------------------------------
# SMTP de respaldo (envío automático del KUDE por email)
# ----------------------------------------
# La forma recomendada es crear Proveedores SMTP desde la UI
# (menú "Proveedores SMTP") y asignarlos a cada empresa en
# Empresas → Editar → Notificaciones. Estas variables son el FALLBACK
# para empresas sin proveedor asignado; si tampoco están definidas,
# el email automático simplemente no se envía (se loguea un aviso).
# SMTP_HOST=smtp.miproveedor.com
# SMTP_PORT=587
# SMTP_USER=facturas@miempresa.com
# SMTP_PASS=
# SMTP_FROM=facturas@miempresa.com
# SMTP_SEGURO=false   # true para TLS directo (puerto 465)
